{
  "name": "slotzy-smoke-tests",
  "private": true,
  "scripts": {
    "serve": "node scripts/serve.cjs",
    "dev:all": "powershell -ExecutionPolicy Bypass -File scripts/dev-all.ps1",
    "make:demo-zip": "node scripts/make-demo-zip.js",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "test:smoke:ui": "playwright test --ui",
    "test:mobile": "playwright test -c playwright.mobile.config.cjs",
    "test:staging": "playwright test -c playwright.staging.config.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1"
  }
}
